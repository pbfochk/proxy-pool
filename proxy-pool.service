[Unit]
Description=Free Proxy Pool Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/proxy-pool
ExecStart=/usr/bin/python3 /opt/proxy-pool/proxy_server.py --port 32580 --interval 300 --anonymity --token YOUR_TOKEN_HERE
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
